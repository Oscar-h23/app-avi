<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
      La sesión autenticada nunca debe salir del dispositivo.
      Room sí puede entrar en el backup según la política del sistema.
    -->
    <exclude
        domain="sharedpref"
        path="avi_keystore_secure_session.xml" />
    <exclude
        domain="sharedpref"
        path="avi_fallback_session.xml" />
</full-backup-content>
